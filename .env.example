# Prisma / SQLite
DATABASE_URL="file:./dev.db"

# API
PORT=3000
NODE_ENV=development

# URL pública usada por los QR y los enlaces /ar/:id.
# Vacío = se deduce del host de la solicitud.
# En producción debe ser la URL HTTPS real (por ejemplo https://webar.paseoaranjuez.com).
PUBLIC_BASE_URL=""

# Autenticación administrativa. Cambia AUTH_SECRET en producción.
AUTH_SECRET="cambia-este-secreto-en-produccion"
# Solo para demostraciones locales sin login: true | false
AUTH_DISABLED="false"

# Orígenes permitidos por CORS (separados por coma). Vacío = mismo origen/reflejar.
CORS_ORIGINS=""

# 8th Wall (opcional). Si dejas VITE_8THWALL_APP_KEY vacío se usa el motor
# open-source desde CDN (sin cuenta). Si la defines, se carga la distribución
# indicada por la aplicación.
VITE_8THWALL_APP_KEY=""
VITE_XR_ENGINE_SRC="https://cdn.jsdelivr.net/npm/@8thwall/engine@0.1.0/dist/xr.js"
VITE_APP_VERSION="1.0.0"

# Mostrar credenciales de demostración en la pantalla de login.
VITE_SHOW_DEMO_CREDENTIALS="true"
