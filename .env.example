# Prisma / SQLite
DATABASE_URL="file:./dev.db"

# API
PORT=3000
HOST=127.0.0.1
# Obligatorios cuando NODE_ENV=production. El proxy NGINX autentica al usuario.
# PUBLIC_ORIGIN=https://armodels.dsmerch.com
# ADMIN_PROXY_TOKEN=<token aleatorio de al menos 32 caracteres>

# 8th Wall (opcional). Si dejas VITE_8THWALL_APP_KEY vacío se usa el motor
# open-source desde CDN (sin cuenta). Si la defines, se carga el motor en la
# nube de 8th Wall con SLAM + Image Targets alojados en tu workspace.
VITE_8THWALL_APP_KEY=""
VITE_XR_ENGINE_SRC="https://cdn.jsdelivr.net/npm/@8thwall/engine@0.1.0/dist/xr.js"
