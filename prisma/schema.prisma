// =============================================================================
// SISTEMA WEBAR BASADO EN IMAGE TRACKING - PASEO ARANJUEZ (COCHABAMBA, BOLIVIA)
// Esquema Prisma (SQLite) con migraciones - OE1 (Sección 2.6.3 y Tabla 2.5)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UsuarioAdministrativo {
  id        String   @id @default(cuid())
  nombre    String
  cargo     String
  rol       String // DIRECCION_MARKETING | GERENCIA | PRODUCCION_DISENO | COMMUNITY_MANAGER | TECNOLOGIA_OPERACIONES
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("usuarios_administrativos")
}

model Local {
  id          String    @id @default(cuid())
  nombre      String    @unique
  rubro       String // Gastronomía | Retail / Moda | Entretenimiento / Cine | Servicios / Oficinas
  ubicacion   String    @map("ubicacion_mall")
  whatsapp    String    @map("contacto_whatsapp")
  descripcion String?
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  campanas    Campana[]

  @@map("locales")
}

model Campana {
  id          Int              @id @default(autoincrement())
  campaignId  String           @map("campaign_id")
  version     Int
  localId     String           @map("local_id")
  local       Local            @relation(fields: [localId], references: [id], onDelete: Restrict)
  nombre      String
  estado      String // EN_PREPARACION | PUBLICADA | ARCHIVADA | VENCIDA
  fechaInicio DateTime         @map("fecha_inicio")
  fechaFin    DateTime         @map("fecha_fin")
  creadoPor   String?          @map("creado_por")
  aprobadoPor String?          @map("aprobado_por")
  createdAt   DateTime         @default(now()) @map("created_at")
  imagenes    ImagenObjetivo[]
  contenidos  Contenido[]

  @@unique([campaignId, version])
  @@map("campanas")
}

model ImagenObjetivo {
  id             Int         @id @default(autoincrement())
  targetId       String      @map("target_id")
  version        Int
  campanaId      Int         @map("campana_id")
  campana        Campana     @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  nombreTecnico  String      @map("nombre_tecnico")
  imagePath      String      @map("image_path")
  thumbnailPath  String      @map("thumbnail_path")
  originalPath   String      @map("original_path")
  propertiesJson String @map("properties_json")
  contrastScore  Float       @map("contrast_score")
  qrAccessUrl    String      @map("qr_access_url")
  createdAt      DateTime    @default(now()) @map("created_at")
  contenidos     Contenido[]

  @@unique([targetId, version])
  @@map("imagenes_objetivo")
}

model Contenido {
  id                 Int            @id @default(autoincrement())
  campanaId          Int            @map("campana_id")
  campana            Campana        @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  imagenObjetivoId   Int            @map("imagen_objetivo_id")
  imagenObjetivo     ImagenObjetivo @relation(fields: [imagenObjetivoId], references: [id], onDelete: Cascade)
  tipoContenido      String         @map("tipo_contenido") // VIDEO_MP4 | IMAGEN_3D | PANEL_INFORMATIVO
  mediaUrl           String         @map("media_url")
  mediaSizeBytes     Int            @map("media_size_bytes")
  mediaMimeType      String         @map("media_mime_type")
  tituloPromocion    String         @map("titulo_promocion")
  condicionesTexto   String         @map("condiciones_texto")
  ctaPrimariaLabel   String         @default("Ver condiciones") @map("cta_primaria_label")
  ctaSecundariaLabel String         @default("Consultar al local") @map("cta_secundaria_label")
  ctaSecundariaUrl   String         @map("cta_secundaria_url")
  overlayConfig      String?        @map("overlay_config")
  createdAt          DateTime       @default(now()) @map("created_at")

  @@map("contenidos")
}

model Sesion {
  sessionId       String    @id @map("session_id")
  campaignId      String    @map("campaign_id")
  campaignVersion Int       @map("campaign_version")
  accessMechanism String    @map("access_mechanism") // QR_CODE | DIRECT_URL
  deviceFamily    String    @map("device_family")
  cameraReady     Boolean   @default(false) @map("camera_ready")
  scanningStarted Boolean   @default(false) @map("scanning_started")
  startedAt       DateTime  @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")
  eventos         Evento[]

  @@index([campaignId, campaignVersion])
  @@map("sesiones")
}

model Evento {
  eventId         String   @id @map("event_id")
  sessionId       String   @map("session_id")
  sesion          Sesion   @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  campaignId      String   @map("campaign_id")
  campaignVersion Int      @map("campaign_version")
  targetId        String?  @map("target_id")
  targetVersion   Int?     @map("target_version")
  eventType       String   @map("event_type")
  payload         String @map("payload")
  clientTime      DateTime @map("client_time")
  receivedAt      DateTime @default(now()) @map("received_at")
  schemaVersion   String   @default("1.0.0") @map("schema_version")

  @@index([campaignId, campaignVersion, eventType])
  @@index([sessionId, eventType])
  @@map("eventos")
}
